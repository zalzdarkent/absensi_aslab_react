@startuml RFID Attendance System
!theme plain
skinparam maxMessageSize 120

title Sequence Diagram - Sistem Absensi RFID


actor "Aslab" as Scanner
boundary "RFID Scanner" as Boundary
control "AttendanceController" as Control
entity "UserEntity" as UserEntity
entity "AttendanceEntity" as AttendanceEntity


Scanner -> Boundary: Scan RFID Code
activate Boundary
Boundary -> Control: Kirim RFID Code
activate Control
Control -> UserEntity: Validasi User
activate UserEntity
UserEntity --> Control: Status User
deactivate UserEntity
Control -> AttendanceEntity: Cek Status Absensi
activate AttendanceEntity
AttendanceEntity --> Control: Status Absensi
deactivate AttendanceEntity

alt RFID Tidak Valid
    Control --> Boundary: Error: RFID tidak terdaftar
else Belum Check-in
    Control -> AttendanceEntity: Simpan Check-in
    AttendanceEntity --> Control: Success
    Control --> Boundary: Berhasil Check-in
else Sudah Check-in, Belum Check-out
    Control -> AttendanceEntity: Simpan Check-out
    AttendanceEntity --> Control: Success
    Control --> Boundary: Berhasil Check-out
else Sudah Lengkap
    Control --> Boundary: Error: Sudah absen hari ini
end

deactivate Control
deactivate Boundary

@enduml
