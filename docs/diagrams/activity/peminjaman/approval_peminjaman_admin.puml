  stop
else (ya)
  :Klik Setujui;
  
  |Sistem|
  :Update Status Approved;
  :Kirim Notifikasi\nke Peminjam (Disetujui);
endif

|Admin|
:Terima Pengembalian\nAset dari Peminjam;

if (Kondisi Baik?) then (tidak)
  :Input Catatan Kerusakan;
else (ya)
endif

:Klik Konfirmasi\nPengembalian;

|Sistem|
:Tambah Stok Kembali;
:Update Status\nDikembalikan;
stop

