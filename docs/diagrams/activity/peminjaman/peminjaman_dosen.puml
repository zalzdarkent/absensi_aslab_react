@startuml Peminjaman Aset dan Bahan (Dosen)
!theme plain
skinparam ConditionEndStyle hline
skinparam conditionStyle diamond

title Activity Diagram - Peminjaman Aset dan Bahan (Dosen)

|Dosen|
|Sistem|

|Dosen|
start
:Pilih Menu\nPeminjaman;

|Sistem|
:Tampilkan Halaman\nPeminjaman Aset/Bahan;

|Dosen|
:Pilih Aset/Bahan\n& Input Jumlah;
:Klik Submit;

|Sistem|
:Validasi Stok;

if (Stok Cukup?) then (tidak)
  :Tampilkan Error\nStok Tidak Cukup;
  stop
else (ya)
  :Kurangi Stok;
  :Simpan Peminjaman\n(Status: Pending);
  :Kirim Notifikasi\nke Admin;
  :Tampilkan Pesan\nMenunggu Approval;
endif

:Proses Approval\noleh Admin;

if (Disetujui?) then (tidak)
  :Kirim Notifikasi\nPeminjaman Ditolak;
  :Kembalikan Stok;
  stop
else (ya)
  :Kirim Notifikasi\nPeminjaman Disetujui;
endif

|Dosen|
:Ambil Aset/Bahan\ndi Lab;

|Sistem|
if (Tipe Aset?) then (ya)
  |Dosen|
  :Kembalikan Aset\nke Lab;
  
  |Sistem|
  :Proses Verifikasi\nPengembalian;
  :Tambah Stok Kembali;
  :Update Status\nDikembalikan;
  stop
else (tidak - Bahan Habis Pakai)
  :Update Status Selesai;
  stop
endif

@enduml
